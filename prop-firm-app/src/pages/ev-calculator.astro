              <th>#</th>
              <th>Firm</th>
              <th>Account</th>
              <th>Pass</th>
              <th>Eval $</th>
              <th>Cost/Funded</th>
              <th>Exp. Payout</th>
              <th>EV/Attempt</th>
            </tr>
          </thead>
          <tbody>
            ${sorted.map((r) => {
              const rank = evRank.get(r.firm.slug);
              const isTop = rank === 1;
              const promoHtml = r.firm.promo_code ? `<span class="promo">CODE ${r.firm.promo_code}</span>` : '';
              const passPct = (r.passProb * 100).toFixed(1);
              const passWidth = Math.min(r.passProb * 100, 100);
              return `<tr class="${isTop ? 'row-top' : ''}">
                <td class="rank">${rank}</td>
                <td class="firm-cell">${r.firm.name}${promoHtml}</td>
                <td>$${(r.firm.account.size/1000)}k</td>
                <td><span class="pass-bar"><span class="pass-fill" style="width:${passWidth}%"></span></span>${passPct}%</td>
                <td>${fmtMoney(r.evalCost)}</td>
                <td>${fmtMoney(r.costToFunded)}</td>
                <td>${fmtMoney(r.fundedPayout)}</td>
                <td class="ev-val">${fmtMoney(r.ev)}</td>
              </tr>`;
            }).join('')}
          </tbody>
        </table>
      `;
      document.getElementById('ranking-table').innerHTML = html;
    }

    // Sort buttons
    document.querySelectorAll('.sort-bar button').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.sort-bar button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        if (lastRanking) renderTable(lastRanking, btn.dataset.sort);
      });
    });

    let lastRanking = null;

    function runCalc(stats) {
      const error = validate(stats);
      if (error) {
        errMsg.textContent = error;
        return;
      }
      errMsg.textContent = '';
      calcBtn.disabled = true;
      calcBtn.textContent = 'Calculating…';

      // Defer to next tick so UI updates
      setTimeout(() => {
        try {
          const derived = calcStats(stats.totalTrades, stats.wins, stats.avgWin, stats.avgLoss);
          const ranking = runSimulation(stats.totalTrades, stats.wins, stats.avgWin, stats.avgLoss);
          lastRanking = ranking;
          renderResults(derived, ranking);
          inputView.style.display = 'none';
          resultsView.style.display = 'block';
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } catch (e) {
          console.error(e);
          errMsg.textContent = 'Simulation error: ' + e.message;
        } finally {
          calcBtn.disabled = false;
          calcBtn.textContent = 'Calculate My EV →';
        }
      }, 50);
    }

    calcBtn.addEventListener('click', () => {
      const stats = getInputStats();
      runCalc(stats);
    });

    // Sample data button — uses the PropFirmEV sample (50 trades, 29 wins, $181.14 avg win, $101.39 avg loss)
    sampleBtn.addEventListener('click', () => {
      const stats = { totalTrades: 50, wins: 29, avgWin: 181.14, avgLoss: 101.39 };
      if (isEstimate) {
        // Switch to exact mode and fill in the sample values
        isEstimate = false;
        exactMode.style.display = 'grid';
        estimateMode.style.display = 'none';
        toggleEstimate.textContent = "Don't know your exact stats? Estimate →";
      }
      document.getElementById('t-total').value = '50';
      document.getElementById('t-wins').value = '29';
      document.getElementById('t-avgwin').value = '181.14';
      document.getElementById('t-avgloss').value = '101.39';
      runCalc(stats);
    });

    backBtn.addEventListener('click', () => {
      resultsView.style.display = 'none';
      inputView.style.display = 'block';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    // Init
    updateEstimatePreview();
    </script>
  </body>
</html>
