---
// EV Calculator — prop firm expected value ranking
// Based on PropFirmEV methodology: Monte Carlo simulation of trade stats vs firm rulebooks
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>EV Calculator — Prop Firm Confidential</title>
    <style is:global>
      :root {
        --bg: #0a0e14;
        --surface: #111821;
        --surface2: #1a2330;
        --border: #243240;
        --text: #eaeef2;
        --muted: #8b98a6;
        --accent: #c0d6e6;
        --pos: #7ed996;
        --neg: #f0857a;
        --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --mono: 'SF Mono', 'Fira Code', 'Cascadia Code', Consolas, monospace;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: var(--font); background: var(--bg); color: var(--text); line-height: 1.5; }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .container { max-width: 920px; margin: 0 auto; padding: 1.5rem 1rem; }

      /* Nav */
      .topnav { display: flex; justify-content: space-between; align-items: center; padding: 0 0 1.5rem; border-bottom: 1px solid var(--border); margin-bottom: 2rem; }
      .topnav .brand { font-size: 1.25rem; font-weight: 600; }
      .topnav .brand span { color: var(--muted); font-weight: 400; font-size: 0.8125rem; }
      .topnav nav { display: flex; gap: 1.25rem; }
      .topnav nav a { color: var(--muted); font-size: 0.875rem; }
      .topnav nav a:hover { color: var(--text); }

      /* Form */
      .hero { margin-bottom: 2rem; text-align: center; }
      .hero h1 { font-size: 1.75rem; font-weight: 700; margin-bottom: 0.5rem; }
      .hero p { color: var(--muted); font-size: 0.9375rem; }

      .card { background: var(--surface); border: 1px solid var(--border); border-radius: 0.75rem; padding: 1.5rem; margin-bottom: 1.5rem; }
      .card h2 { font-size: 1.125rem; font-weight: 600; margin-bottom: 0.25rem; }
      .card .sub { color: var(--muted); font-size: 0.8125rem; margin-bottom: 1rem; }

      .input-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-bottom: 1.25rem; }
      @media (min-width: 640px) { .input-grid { grid-template-columns: repeat(4, 1fr); } }
      .field label { display: block; font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin-bottom: 0.25rem; }
      .field input { width: 100%; background: var(--surface2); border: 1px solid var(--border); border-radius: 0.5rem; padding: 0.625rem 0.75rem; color: var(--text); font-family: var(--mono); font-size: 1rem; outline: none; }
      .field input:focus { border-color: var(--accent); }
      .field .hint { display: block; font-size: 0.6875rem; color: var(--muted); margin-top: 0.25rem; }

      .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.25rem; border-radius: 0.5rem; font-size: 0.875rem; font-weight: 500; cursor: pointer; border: 1px solid var(--border); background: var(--surface2); color: var(--text); transition: opacity 0.15s; }
      .btn:disabled { opacity: 0.5; cursor: not-allowed; }
      .btn-primary { background: var(--accent); color: var(--bg); border-color: var(--accent); font-weight: 600; }
      .btn-text { background: none; border: none; color: var(--accent); font-size: 0.8125rem; padding: 0; text-decoration: underline; text-underline-offset: 2px; }
      .form-actions { display: flex; flex-direction: column; gap: 0.75rem; align-items: stretch; }
      @media (min-width: 640px) { .form-actions { flex-direction: row; justify-content: space-between; align-items: center; } }
      .error { color: var(--neg); font-size: 0.8125rem; }

      /* Estimate mode */
      .estimate-controls { display: flex; flex-direction: column; gap: 1.25rem; }
      .slider-row label { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
      .slider-row .val { font-family: var(--mono); font-size: 1rem; font-weight: 600; float: right; }
      .slider-row input[type=range] { width: 100%; margin: 0.5rem 0; accent-color: var(--accent); }
      .slider-row .scale { display: flex; justify-content: space-between; font-size: 10px; color: var(--muted); }
      .slider-row select { width: 100%; background: var(--surface2); border: 1px solid var(--border); border-radius: 0.5rem; padding: 0.5rem; color: var(--text); font-size: 0.875rem; }
      .preview-box { background: var(--surface2); border-radius: 0.5rem; padding: 0.75rem; font-size: 0.8125rem; color: var(--muted); margin-top: 0.25rem; }
      .preview-box .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; margin-top: 0.25rem; }
      .preview-box .grid span { font-family: var(--mono); color: var(--text); }

      /* Results */
      #results { display: none; }
      .result-header { text-align: center; margin-bottom: 1.5rem; }
      .result-header .label { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; }
      .result-header h1 { font-size: 1.75rem; margin: 0.25rem 0; }
      .result-header .meta { color: var(--muted); font-size: 0.8125rem; }

      .stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; margin-bottom: 0.5rem; }
      @media (min-width: 640px) { .stats-grid { grid-template-columns: repeat(4, 1fr); } }
      .stat-card { background: var(--surface); border: 1px solid var(--border); border-radius: 0.5rem; padding: 0.875rem; }
      .stat-card .lbl { font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
      .stat-card .num { font-family: var(--mono); font-size: 1.25rem; font-weight: 600; margin-top: 0.25rem; }

      .top-match { background: var(--surface); border: 1px solid var(--border); border-radius: 0.75rem; padding: 1.5rem; margin-bottom: 1.5rem; }
      .top-match .badge { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--pos); }
      .top-match .firm-name { font-size: 1.5rem; font-weight: 700; margin: 0.25rem 0; }
      .top-match .firm-summary { color: var(--muted); font-size: 0.875rem; margin-bottom: 1rem; }
      .top-match .ev-box { display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 0.5rem; }
      .top-match .ev-box .lbl { font-size: 0.6875rem; text-transform: uppercase; color: var(--muted); }
      .top-match .ev-box .val { font-family: var(--mono); font-size: 1.75rem; font-weight: 700; color: var(--pos); }
      .top-match .why { font-size: 0.875rem; color: var(--muted); margin-top: 0.75rem; }
      .top-match .try-link { display: inline-block; margin-top: 1rem; padding: 0.5rem 1rem; background: var(--accent); color: var(--bg); border-radius: 0.5rem; font-weight: 600; font-size: 0.875rem; }

      /* Ranking table */
      .ranking-section { margin-bottom: 1.5rem; }
      .ranking-section h2 { font-size: 1.0625rem; font-weight: 600; margin-bottom: 0.75rem; }
      .sort-bar { display: flex; gap: 0.5rem; margin-bottom: 0.75rem; align-items: center; flex-wrap: wrap; }
      .sort-bar .label { font-size: 0.8125rem; color: var(--muted); }
      .sort-bar button { padding: 0.25rem 0.625rem; border-radius: 0.375rem; border: 1px solid var(--border); background: var(--surface2); color: var(--muted); font-size: 0.75rem; cursor: pointer; }
      .sort-bar button.active { border-color: var(--accent); color: var(--text); }

      .ranking-table { overflow-x: auto; border: 1px solid var(--border); border-radius: 0.75rem; }
      .ranking-table table { width: 100%; border-collapse: collapse; min-width: 680px; }
      .ranking-table th { padding: 0.625rem 0.75rem; text-align: right; font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); border-bottom: 1px solid var(--border); white-space: nowrap; }
      .ranking-table th:first-child, .ranking-table td:first-child { text-align: center; width: 2rem; }
      .ranking-table th:nth-child(2), .ranking-table td:nth-child(2) { text-align: left; }
      .ranking-table td { padding: 0.625rem 0.75rem; font-size: 0.875rem; border-bottom: 1px solid var(--border); text-align: right; font-family: var(--mono); white-space: nowrap; }
      .ranking-table td:nth-child(2) { font-family: var(--font); }
      .ranking-table tr:last-child td { border-bottom: none; }
      .ranking-table tr.row-top td { background: rgba(126, 217, 150, 0.04); }
      .ranking-table .rank { color: var(--muted); font-size: 0.75rem; }
      .ranking-table .firm-cell { font-weight: 500; }
      .ranking-table .promo { display: inline-block; font-size: 0.625rem; padding: 0.0625rem 0.375rem; border-radius: 0.25rem; background: var(--surface2); color: var(--muted); margin-left: 0.375rem; border: 1px solid var(--border); }
      .ranking-table .pass-bar { display: inline-block; width: 2.5rem; height: 0.25rem; border-radius: 999px; background: var(--surface2); margin-right: 0.25rem; vertical-align: middle; }
      .ranking-table .pass-fill { display: block; height: 100%; border-radius: 999px; background: var(--pos); }
      .ranking-table .ev-val { font-weight: 600; color: var(--pos); }
      .paths-toggle { background: var(--surface2); border: 1px solid var(--border); border-radius: 0.375rem; padding: 0.125rem 0.5rem; font-size: 0.6875rem; color: var(--muted); cursor: pointer; }
      .paths-toggle:hover { color: var(--text); }

      .loading { text-align: center; padding: 2rem; color: var(--muted); font-size: 0.875rem; }
      .how { color: var(--muted); font-size: 0.8125rem; margin-top: 2rem; }
      .how h3 { font-size: 1rem; color: var(--text); margin-bottom: 0.5rem; }
      .how ol { padding-left: 1.25rem; line-height: 1.7; }
      .how code { font-family: var(--mono); font-size: 0.8125rem; background: var(--surface2); padding: 0.125rem 0.375rem; border-radius: 0.25rem; }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="topnav">
        <div class="brand">Prop Firm Confidential <span>· EV Calculator</span></div>
        <nav>
          <a href="/">Firms</a>
          <a href="/compare">Compare</a>
          <a href="/ev-calculator">EV Calculator</a>
        </nav>
      </div>

      <!-- INPUT VIEW -->
      <div id="input-view">
        <div class="hero">
          <h1>Which prop firm is easiest for you to pass?</h1>
          <p>Four numbers from your trading history. We simulate each firm's rules against your style and tell you which one your trading is most likely to fund.</p>
        </div>

        <div class="card" id="form-card">
          <h2>Enter your stats</h2>
          <div class="sub">Free · No data leaves your browser · Simulation runs client-side</div>

          <div id="exact-mode" class="input-grid">
            <div class="field">
              <label>Total trades</label>
              <input id="t-total" type="text" inputmode="numeric" value="50" placeholder="50" />
              <span class="hint">Last 50+ recommended</span>
            </div>
            <div class="field">
              <label>Wins</label>
              <input id="t-wins" type="text" inputmode="numeric" value="22" placeholder="22" />
              <span class="hint">Profitable trades</span>
            </div>
            <div class="field">
              <label>Avg win ($)</label>
              <input id="t-avgwin" type="text" inputmode="decimal" value="180" placeholder="180" />
              <span class="hint">Across all winners</span>
            </div>
            <div class="field">
              <label>Avg loss ($)</label>
              <input id="t-avgloss" type="text" inputmode="decimal" value="120" placeholder="120" />
              <span class="hint">Across all losers</span>
            </div>
          </div>

          <div id="estimate-mode" class="estimate-controls" style="display:none;">
            <div class="slider-row">
              <label>Win rate <span class="val" id="wr-val">45%</span></label>
              <input id="s-wr" type="range" min="30" max="70" step="1" value="45" />
              <div class="scale"><span>30%</span><span>50%</span><span>70%</span></div>
            </div>
            <div class="slider-row">
              <label>Reward-to-risk <span class="val" id="rr-val">1.50 : 1</span></label>
              <input id="s-rr" type="range" min="0.5" max="3" step="0.05" value="1.5" />
              <div class="scale"><span>0.5 : 1</span><span>1 : 1</span><span>3 : 1</span></div>
            </div>
            <div class="slider-row">
              <label>Trades per sample</label>
              <select id="s-trades">
                <option value="25">25 trades</option>
                <option value="50" selected>50 trades</option>
                <option value="100">100 trades</option>
                <option value="200">200 trades</option>
                <option value="500">500 trades</option>
              </select>
            </div>
            <div class="preview-box" id="est-preview"></div>
          </div>

          <div class="form-actions" style="margin-top:1.25rem;">
            <div>
              <button class="btn-text" id="toggle-estimate">Don't know your exact stats? Estimate →</button>
            </div>
            <div style="display:flex; gap:0.75rem; align-items:center;">
              <span class="error" id="err-msg"></span>
              <button class="btn btn-primary" id="calc-btn">Calculate My EV →</button>
            </div>
          </div>
        </div>

        <div style="text-align:center; margin-bottom:2rem;">
          <button class="btn-text" id="sample-btn">Try with sample data →</button>
        </div>

        <div class="how">
          <h3>How it works</h3>
          <ol>
            <li><strong>Type four numbers</strong> — total trades, wins, avg win, avg loss. Pull from any platform's performance tab.</li>
            <li><strong>We simulate each firm</strong> — 1,000 Monte Carlo runs per firm, re-running your trade distribution through their real drawdown, profit target, and daily loss rules.</li>
            <li><strong>You see the shortlist</strong> — one ranked list by expected value (EV). The top firm is where your style makes the most money on average.</li>
          </ol>
          <p style="margin-top:0.75rem;"><code>EV = pass_prob × payout − pass_prob × activation_fee − eval_cost</code></p>
        </div>
      </div>

      <!-- RESULTS VIEW -->
      <div id="results">
        <div class="result-header">
          <div class="label">YOUR REPORT</div>
          <h1 id="best-fit">—</h1>
          <div class="meta" id="report-meta">—</div>
        </div>

        <div class="card">
          <h2>Your stats</h2>
          <div class="stats-grid" id="stats-grid"></div>
        </div>

        <div class="top-match" id="top-match"></div>

        <div class="ranking-section">
          <h2 id="ranking-title">Full ranking</h2>
          <div class="sort-bar">
            <span class="label">Sort:</span>
            <button data-sort="ev" class="active">EV (highest)</button>
            <button data-sort="size-asc">Account size ↑</button>
            <button data-sort="size-desc">Account size ↓</button>
          </div>
          <div class="ranking-table" id="ranking-table"></div>
        </div>

        <div class="card" style="margin-top:1.5rem;">
          <button class="btn" id="back-btn">← Run again with different stats</button>
        </div>

        <div class="how">
          <h3>Methodology</h3>
          <ol>
            <li><strong>Pass probability</strong> — 1,000 simulated evaluations per firm. Each attempt: up to 400 trades, one per day. Win with probability = your win rate. EOD trailing drawdown floor updated after each trade. Fail if balance drops below floor or daily loss limit breached. Pass if profit target hit first.</li>
            <li><strong>Expected payout</strong> — 2,000-run funded-phase simulation. Trader trades 1/day until +$2,000 or bust on trailing floor. If +$2k: withdraw $1,000, lock drawdown at breakeven, then 5 more winning days for another $1,000. Total: $2,000. If bust: $0.</li>
            <li><strong>EV per attempt</strong> — <code>pass_prob × payout − pass_prob × activation_fee − eval_cost</code>. Eval cost paid every attempt. Activation fee only on pass.</li>
          </ol>
          <p style="margin-top:0.75rem; color:var(--muted); font-size:0.75rem;">Firm data verified May 25, 2026. Rules change frequently — always verify on the firm's official site. Some outbound links may be affiliate links. Rankings are based on your expected value, not commissions.</p>
        </div>
      </div>
    </div>

