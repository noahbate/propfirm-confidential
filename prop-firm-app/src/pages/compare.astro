---
// /Users/hermes/projects/propfirm-confidential/prop-firm-app/src/pages/compare.astro
const BACKEND_URL = 'https://prop-firm-api-bc7y.onrender.com';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Compare — Prop Firm Confidential</title>
  </head>
  <body>
    <main class="max-w-6xl mx-auto p-4 sm:p-6">
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-semibold">Compare Prop Firms</h1>
        <div class="flex gap-4">
          <a href="/ev-calculator" class="text-sm underline">EV Calculator</a>
          <a href="/" class="text-sm underline">Back to table</a>
        </div>
      </div>

      <div class="mb-6">
        <p class="text-sm text-gray-600 mb-3">Select up to 3 firms to compare side by side. Sign in to save favorites.</p>
        <div id="selector" class="flex flex-col gap-2"></div>
      </div>

      <div id="comparison" class="overflow-x-auto border rounded"></div>
      <div id="save-panel" class="mt-4 flex items-center gap-2"></div>
    </main>

    <script is:inline>
      const BACKEND = 'https://prop-firm-api-bc7y.onrender.com';
      const MAX = 3;
      let selected = new Set();
      let authState = { token: null, user: null, favorites: [] };

      function fmtNum(n) { return typeof n === 'number' ? n : '—'; }
      function fmtSplit(n) { return typeof n === 'number' ? Math.round(n * 100) + '%' : '—'; }

      async function api(path, opts = {}) {
        const headers = Object.assign({}, opts.headers || {}, { 'Content-Type': 'application/json' });
        if (authState.token) headers['Authorization'] = 'Bearer ' + authState.token;
        const res = await fetch(BACKEND + path, Object.assign({}, opts, { headers }));
        const data = await res.json().catch(() => ({}));
        if (opts.parseJson === false) return res;
        if (!res.ok) throw new Error(data && (data.detail || data.error) || ('Request failed: ' + res.status));
        return data;
      }

      function bindAuth() {
        const saved = localStorage.getItem('auth_cache');
        if (!saved) return;
        try { const cached = JSON.parse(saved); authState.token = cached.token; authState.user = cached.user; } catch (e) {}
        loadFavorites();
        renderSavePanel();
      }

      async function loadFavorites() {
        if (!authState.user) return;
        try {
          const favs = await api('/auth/favorites/' + encodeURIComponent(authState.user.id));
          authState.favorites = Array.isArray(favs.favorites) ? favs.favorites : [];
        } catch (e) { authState.favorites = []; }
      }

      function persistAuth() {
        const toStore = { token: authState.token, user: authState.user };
        localStorage.setItem('auth_cache', JSON.stringify(toStore));
      }

      function renderSavePanel() {
        const panel = document.getElementById('save-panel');
        panel.innerHTML = '';
        if (!authState.user || !selected.size) return;
        const name = authState.user.name || authState.user.id;
        const isSaved = localStorage.getItem('compare_saved: ' + authState.user.id) === Array.from(selected).sort().join(',');
        panel.innerHTML = `
          <span class="text-sm text-gray-600">Signed in as <strong>${name}</strong></span>
          ${!isSaved ? '<button id="save-compare" class="text-sm underline">Save selection</button>' : '<span class="text-sm text-green-700">Saved ✓</span>'}
          <button id="logout" class="text-sm underline ml-2">Sign out</button>
        `;
        document.getElementById('logout').addEventListener('click', () => {
          authState.token = null; authState.user = null; authState.favorites = [];
          localStorage.removeItem('auth_cache');
          promptLogin();
        });
        document.getElementById('save-compare')?.addEventListener('click', async () => {
          localStorage.setItem('compare_saved: ' + authState.user.id, Array.from(selected).sort().join(','));
          renderSavePanel();
        });
      }

      function promptLogin() {
        if (document.getElementById('auth-modal')) return;
        const modal = document.createElement('div');
        modal.id = 'auth-modal';
        modal.className = 'fixed inset-0 bg-gray-700/50 flex items-center justify-center';
        modal.innerHTML = `
          <div class="bg-white rounded shadow-lg p-5 w-full max-w-sm">
            <h3 class="text-lg font-semibold mb-2">Sign in</h3>
            <form id="login-form" class="flex flex-col gap-2">
              <input type="email" id="login-email" required placeholder="Email" class="border rounded px-3 py-2" />
              <input type="password" id="login-password" required placeholder="Password" class="border rounded px-3 py-2" />
              <input type="text" id="login-name" placeholder="Name (optional)" class="border rounded px-3 py-2" />
              <button type="submit" class="bg-gray-900 text-white rounded px-3 py-2">Sign up / Sign in</button>
            </form>
            <p class="mt-2 text-xs text-gray-500">This uses a temporary account store for saved preferences only.</p>
            <button id="auth-close" class="mt-3 text-sm text-gray-600 underline">Close</button>
          </div>
        `;
        document.body.appendChild(modal);
        document.getElementById('auth-close').addEventListener('click', () => modal.remove());
        modal.addEventListener('click', (e) => { if (e.target === modal) modal.remove(); });
        document.getElementById('login-form').addEventListener('submit', async (e) => {
          e.preventDefault();
          const email = document.getElementById('login-email').value.trim();
          const password = document.getElementById('login-password').value.trim();
          const name = document.getElementById('login-name').value.trim() || email;
          try {
            const res = await api('/auth/login', { method: 'POST', body: JSON.stringify({ email, password }) });
            if (!res.token) throw new Error('Login response missing token');
            authState.token = res.token;
            authState.user = { id: res.user_id, name: res.name };
            persistAuth();
            await loadFavorites();
            renderSavePanel();
            renderComparison();
            renderSelection();
          } catch (err) {
            await api('/auth/register', { method: 'POST', body: JSON.stringify({ email, password, name }) }).then((res) => {
              authState.token = res.token;
              authState.user = { id: res.user_id, name: res.name };
              persistAuth();
              loadFavorites().then(() => { renderSavePanel(); renderComparison(); renderSelection(); });
            }).catch(() => { alert(err.message || 'Authentication failed'); });
          }
          modal.remove();
        });
      }

      function renderSelection() {
        const sel = document.getElementById('selector');
        const firms = window.__PROP_FIRMS__ || [];
        sel.innerHTML = '';
        firms.forEach((item) => {
          const name = item.firm_information.firm_name;
          const checked = selected.has(name);
          const row = document.createElement('label');
          row.className = 'flex items-center gap-3 cursor-pointer select-none';
          const cb = document.createElement('input');
          cb.type = 'checkbox';
          cb.checked = checked;
          cb.disabled = !checked && selected.size >= MAX;
          cb.addEventListener('change', () => toggle(name));
          const text = document.createElement('span');
          text.className = 'text-sm text-gray-800';
          text.textContent = name;
          row.appendChild(cb);
          row.appendChild(text);
          sel.appendChild(row);
        });
      }

      function toggle(name) {
        if (selected.has(name)) selected.delete(name);
        else if (selected.size < MAX) selected.add(name);
        renderSelection();
        renderComparison();
        renderSavePanel();
      }

      function computeScore(item) {
        function num(v) { return typeof v === 'number' ? v : 0; }
        function clamp(v, lo, hi) { return v < lo ? lo : v > hi ? hi : v; }
        const DRAW_TYPES = { EOD: 1, Static: 2, Trailing: 3 };
        const STRICT_OVERHEAD_PENALTY = 80;
        const MIN_ACTIVATION_COMPARE = 85;
        const accountSize = (f) => num(f.account_details.account_size);
        const price = num(item.account_details.price);
        const activation = num(item.account_details.activation_fee);
        const profitSplit = num(item.account_details.profit_split);
        const profitTarget = num(item.account_details.profit_target);
        const drawdown = num(item.account_details.max_drawdown);
        const days = num(item.rules_and_parameters.max_trading_days ?? item.rules_and_parameters.min_trading_days);
        if (!price || !accountSize(item)) return 0;
        const drawdownPenalty = DRAW_TYPES[item.account_details.drawdown_type] === 3 ? 100 : 0;
        const activationPenalty = (item.account_details.sale_price ?? null) == null && activation >= MIN_ACTIVATION_COMPARE ? STRICT_OVERHEAD_PENALTY : 0;
        const daysPenalty = clamp(days, 0, 30) * 2.5;
        const profitSplitPenalty = (1 - profitSplit) * 150;
        const raw = (profitTarget - drawdown) + activation + activationPenalty + daysPenalty + drawdownPenalty + profitSplitPenalty;
        return Math.max(0, Math.round(raw));
      }

      function diffHint(label, rows) {
        const hints = {
          score: 'Lower overhead and more favorable terms improve this score.',
          profit_split: 'Higher retained profit is favorable.',
          drawdown_type: 'Static or EOD drawdowns are generally less risky than trailing.',
          min_trading_days: 'Shorter qualification windows are often easier to complete.',
          max_trading_days: 'Shorter maximum evaluation windows add pressure.',
          activation_fee: 'Higher activation fees reduce overall value unless offset by lower pricing.',
          price: 'Lower purchase cost is favorable.',
          sale_price: 'A discounted sale price improves value.',
          profit_target: 'Lower targets are easier to reach.',
          max_drawdown: 'Higher drawdown limit is less restrictive.',
          allowed_instruments: 'Futures access is generally preferred for this project.',
          scaling_plan: 'Scaling plans help increase capital over time.',
        };
        return hints[label] || 'This field contributes to overall suitability.';
      }

      function fmtValue(value, col) {
        if (col === 'profit_split') return fmtSplit(value);
        if (typeof value === 'boolean') return value ? 'Yes' : 'No';
        return fmtNum(value);
      }

      function renderRichComparison(items) {
        const wrap = document.getElementById('comparison');
        wrap.innerHTML = '';
        if (!items.length) {
          wrap.innerHTML = '<div class="p-6 text-center text-sm text-gray-500">Pick firms above to see the side-by-side view.</div>';
          return;
        }

        const scores = items.map((f) => computeScore(f));
        const winnerIdx = scores.indexOf(Math.max(...scores));

        const recommendation = document.createElement('div');
        recommendation.className = 'border rounded bg-white p-4 mb-4';
        const best = items[winnerIdx];
        recommendation.innerHTML = `
          <div class="text-sm font-medium text-gray-900">Recommendation</div>
          <div class="text-sm text-gray-800 mt-1">
            Based on the scoring model, the best option is <strong>${best.firm_information.firm_name} — ${best.account_details.account_name}</strong> (score ${scores[winnerIdx]}). This option balances cost, profit split, drawdown type, and time-based terms most favorably.
          </div>
        `;
        wrap.appendChild(recommendation);

        const cols = [
          { label: 'Score', key: 'score', computeItem: (f) => computeScore(f) },
          { label: 'Account size', key: 'account_size', computeItem: (f) => f.account_details.account_size },
          { label: 'Price', key: 'price', computeItem: (f) => f.account_details.price },
          { label: 'Sale price', key: 'sale_price', computeItem: (f) => f.account_details.sale_price },
          { label: 'Profit split', key: 'profit_split', fmt: (v) => fmtValue(v, 'profit_split'), computeItem: (f) => f.account_details.profit_split },
          { label: 'Profit target', key: 'profit_target', computeItem: (f) => f.account_details.profit_target },
          { label: 'Max drawdown', key: 'max_drawdown', computeItem: (f) => f.account_details.max_drawdown },
          { label: 'Drawdown', key: 'drawdown_type', computeItem: (f) => f.account_details.drawdown_type },
          { label: 'Min trading days', key: 'min_trading_days', computeItem: (f) => f.rules_and_parameters.min_trading_days },
          { label: 'Max trading days', key: 'max_trading_days', computeItem: (f) => f.rules_and_parameters.max_trading_days },
          { label: 'Scaling plan', key: 'scaling_plan', computeItem: (f) => f.rules_and_parameters.scaling_plan },
          { label: 'Instruments', key: 'allowed_instruments', fmt: (v) => Array.isArray(v) ? v.join(', ') : String(v ?? '—'), computeItem: (f) => f.rules_and_parameters.allowed_instruments },
        ];

        const differences = document.createElement('div');
        differences.className = 'border rounded bg-white';
        cols.forEach((col) => {
          const values = items.map((f) => col.computeItem(f));
          const distinct = new Set(values.map((v) => (v === undefined || v === null ? '~null' : typeof v === 'object' ? JSON.stringify(v) : v)));
          if (distinct.size <= 1) return;

          const row = document.createElement('div');
          row.className = 'grid grid-cols-1 sm:grid-cols-3 gap-3 px-4 py-3';

          const labelCell = document.createElement('div');
          labelCell.className = 'text-sm font-medium text-gray-900';
          labelCell.textContent = col.label;
          row.appendChild(labelCell);

          const valuesCell = document.createElement('div');
          valuesCell.className = 'sm:col-span-2 text-sm';
          const grid = document.createElement('div');
          grid.className = 'grid grid-cols-3 gap-3';
          values.forEach((value, idx) => {
            const card = document.createElement('div');
            const isWinner = idx === winnerIdx;
            card.className = `rounded border px-3 py-2 ${isWinner ? 'border-green-300 bg-green-50' : 'border-gray-200 bg-white'}`;
            const meta = document.createElement('div');
            meta.className = 'text-xs text-gray-600 mb-1';
            meta.textContent = items[idx].firm_information.firm_name;
            const val = document.createElement('div');
            val.className = isWinner ? 'text-green-900 font-medium' : 'text-gray-900';
            val.textContent = typeof col.fmt === 'function' ? col.fmt(value) : (value === null || value === undefined ? '—' : typeof value === 'boolean' ? (value ? 'Yes' : 'No') : String(value));
            card.appendChild(meta);
            card.appendChild(val);
            grid.appendChild(card);
          });
          valuesCell.appendChild(grid);
          const hint = document.createElement('div');
          hint.className = 'text-xs text-gray-600 mt-2';
          hint.textContent = diffHint(col.key);
          valuesCell.appendChild(hint);
          row.appendChild(valuesCell);
          differences.appendChild(row);
        });
        wrap.appendChild(differences);

        const scoreTable = document.createElement('div');
        scoreTable.className = 'mt-6 border rounded overflow-x-auto bg-white';
        scoreTable.innerHTML = `
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Firm</th>
                ${items.map((f) => `<th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">${f.firm_information.firm_name} — ${f.account_details.account_name}</th>`).join('')}
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <tr>
                <td class="px-4 py-2 text-sm font-medium text-gray-900">Score</td>
                ${items.map((f, i) => `<td class="px-4 py-2 text-sm text-gray-900 ${i === winnerIdx ? 'font-semibold text-green-700' : ''}">${computeScore(f)}</td>`).join('')}
              </tr>
            </tbody>
          </table>
        `;
        wrap.appendChild(scoreTable);
      }

      function renderComparison() {
        const wrap = document.getElementById('comparison');
        wrap.innerHTML = '';
        if (!selected.size) {
          wrap.innerHTML = '<div class="p-6 text-center text-sm text-gray-500">Pick firms above to see the side-by-side view.</div>';
          return;
        }
        const firms = window.__PROP_FIRMS__ || [];
        const items = [];
        selected.forEach((name) => {
          const match = firms.find((f) => f.firm_information.firm_name === name);
          if (match) items.push(match);
        });
        renderRichComparison(items);
      }

      async function init() {
        bindAuth();
        const sel = document.getElementById('selector');
        try {
          const res = await fetch(BACKEND + '/api/prop-firms');
          const data = await res.json();
          const items = Array.isArray(data) ? data : [];
          window.__PROP_FIRMS__ = items;
          renderSelection();
          renderComparison();
          bindAuth();
        } catch (e) {
          sel.textContent = 'Failed to load firms.';
        }
      }

      init();
    </script>
  </body>
</html>
