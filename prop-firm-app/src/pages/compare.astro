---
const BACKEND_URL = 'https://prop-firm-api-bc7y.onrender.com';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Compare — Prop Firm Confidential</title>
  </head>

  <body>
    <main class="max-w-6xl mx-auto p-4 sm:p-6">
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-semibold">Compare Prop Firms</h1>
        <a href="/" class="text-sm underline">Back to table</a>
      </div>

      <div class="mb-6">
        <p class="text-sm text-gray-600 mb-3">Select up to 3 firms to compare side by side.</p>
        <div id="selector" class="flex flex-col gap-2"></div>
      </div>

      <div id="comparison" class="overflow-x-auto border rounded"></div>
    </main>

    <script is:inline>
      const backendUrl = 'https://prop-firm-api-bc7y.onrender.com/api/prop-firms';
      const MAX = 3;
      let selected = new Set();

      function renderComparison() {
        const wrap = document.getElementById('comparison');
        wrap.innerHTML = '';
        if (selected.size === 0) {
          wrap.innerHTML = '<div class="p-6 text-center text-sm text-gray-500">Pick firms above to see the side-by-side view.</div>';
          return;
        }
        const firms = window.__PROP_FIRMS__ || [];
        const items = firms.filter(f => selected.has(f.firm_information.firm_name));
        if (!items.length) return;

        const table = document.createElement('table');
        table.className = 'min-w-full divide-y divide-gray-200';
        const thead = document.createElement('thead');
        const headRow = document.createElement('tr');
        const corner = document.createElement('th');
        corner.className = 'px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider bg-gray-50';
        corner.textContent = 'Metric';
        headRow.appendChild(corner);
        items.forEach(item => {
          const th = document.createElement('th');
          th.className = 'px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider bg-gray-50';
          th.innerHTML = `<div class="flex items-center gap-2"><img src="${item.firm_information.firm_logo_url}" alt="" class="h-6 w-6 rounded-full object-cover" /><span>${item.firm_information.firm_name}</span></div>`;
          headRow.appendChild(th);
        });
        thead.appendChild(headRow);
        table.appendChild(thead);

        const tbody = document.createElement('tbody');
        tbody.className = 'bg-white divide-y divide-gray-200';

        const rows = [
          { label: 'Account', key: 'account_name' },
          { label: 'Price', key: 'price' },
          { label: 'Sale price', key: 'sale_price' },
          { label: 'Profit split', key: 'profit_split', fmt: (n) => typeof n === 'number' ? Math.round(n * 100) + '%' : '—' },
          { label: 'Profit target', key: 'profit_target' },
          { label: 'Max drawdown', key: 'max_drawdown' },
          { label: 'Activation fee', key: 'activation_fee' },
          { label: 'Drawdown', key: 'drawdown_type' },
          { label: 'Instruments', key: 'allowed_instruments', transform: (v) => Array.isArray(v) ? v.join(', ') : v },
          { label: 'Scaling plan', key: 'scaling_plan' },
          { label: 'Min trading days', key: 'min_trading_days' }
        ];

        rows.forEach(r => {
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-gray-50';

          const tdLabel = document.createElement('td');
          tdLabel.className = 'px-4 py-3 text-sm font-medium text-gray-900 whitespace-nowrap bg-gray-50';
          tdLabel.textContent = r.label;
          tr.appendChild(tdLabel);

          const vals = items.map(item => {
            if (r.key === 'allowed_instruments') return item.rules_and_parameters.allowed_instruments || '—';
            if (r.key === 'scaling_plan') return item.rules_and_parameters.scaling_plan ? 'Yes' : 'No';
            return item.account_details[r.key];
          });

          const numeric = vals.every(v => typeof v === 'number');
          if (numeric) {
            const min = Math.min(...vals);
            vals.forEach((v, idx) => {
              const td = document.createElement('td');
              td.className = 'px-4 py-3 text-sm whitespace-nowrap';
              td.textContent = v;
              if (v === min && vals.length > 1) td.className += ' font-semibold text-green-700';
              tr.appendChild(td);
            });
          } else {
            vals.forEach(v => {
              const td = document.createElement('td');
              td.className = 'px-4 py-3 text-sm whitespace-nowrap';
              if (r.key === 'scaling_plan') td.textContent = v ? 'Yes' : 'No';
              else if (r.key === 'allowed_instruments') td.textContent = Array.isArray(v) ? v.join(', ') : (v ?? '—');
              else if (r.fmt) td.textContent = r.fmt(v);
              else if (typeof v === 'number') td.textContent = v;
              else td.textContent = v ?? '—';
              tr.appendChild(td);
            });
          }

          tbody.appendChild(tr);
        });

        table.appendChild(tbody);
        wrap.appendChild(table);
      }

      function toggle(name) {
        if (selected.has(name)) {
          selected.delete(name);
        } else {
          if (selected.size >= MAX) return;
          selected.add(name);
        }
        renderSelection();
        renderComparison();
      }

      function renderSelection() {
        const sel = document.getElementById('selector');
        const firms = window.__PROP_FIRMS__ || [];
        sel.innerHTML = '';
        firms.forEach(item => {
          const name = item.firm_information.firm_name;
          const checked = selected.has(name);
          const row = document.createElement('label');
          row.className = 'flex items-center gap-3 cursor-pointer select-none';

          const cb = document.createElement('input');
          cb.type = 'checkbox';
          cb.checked = checked;
          cb.disabled = !checked && selected.size >= MAX;
          cb.addEventListener('change', () => toggle(name));

          const text = document.createElement('span');
          text.className = 'text-sm text-gray-800';
          text.textContent = name;

          row.appendChild(cb);
          row.appendChild(text);
          sel.appendChild(row);
        });
      }

      async function init() {
        const sel = document.getElementById('selector');
        try {
          const res = await fetch(backendUrl);
          const data = await res.json();
          const items = Array.isArray(data) ? data : [];
          window.__PROP_FIRMS__ = items;
          renderSelection();
          renderComparison();
        } catch (e) {
          sel.textContent = 'Failed to load firms.';
        }
      }

      init();
    </script>
  </body>
</html>
