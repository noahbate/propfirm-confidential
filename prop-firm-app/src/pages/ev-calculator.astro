      if (!Number.isFinite(stats.avgWin) || stats.avgWin <= 0) return 'Avg win must be greater than 0.';
      if (!Number.isFinite(stats.avgLoss) || stats.avgLoss <= 0) return 'Avg loss must be greater than 0.';
      return null;
