    const PASSES = 1000;        // Monte Carlo evaluation attempts per firm
    const FUNDED_PASSES = 2000;  // Monte Carlo funded-phase attempts per firm
    const MAX_TRADES = 400;      // max trades per evaluation attempt
    const FUNDED_TARGET = 2000;  // funded-phase profit target for first payout cycle
    const FUNDED_PAYOUT = 2000;  // total payout if funded cycle succeeds

    // Deterministic PRNG (mulberry32) for reproducible results
    function mulberry32(seed) {
      return function() {
        seed |= 0; seed = seed + 0x6D2B79F5 | 0;
        let t = Math.imul(seed ^ seed >>> 15, 1 | seed);
        t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
        return ((t ^ t >>> 14) >>> 0) / 4294967296;
      };
    }

    function seedFrom(trades, wins, avgWin, avgLoss) {
      // Deterministic seed from inputs
      const s = `${trades},${wins},${avgWin},${avgLoss}`;
      let h = 0;
      for (let i = 0; i < s.length; i++) {
        h = ((h << 5) - h + s.charCodeAt(i)) | 0;
      }
      return Math.abs(h) || 1;
    }

    // Single evaluation attempt through a firm's rulebook
    function simulateEvalAttempt(winRate, avgWin, avgLoss, firm, rng) {
      const a = firm.account;
      const balance = 0;
      let cur = 0;
      const maxDD = a.max_dd;
      const dailyLoss = a.daily_loss;  // 0 = no DLL
      const target = a.profit_target;
      const isEOD = firm.drawdown_mode === 'eod';

      // EOD trailing floor starts at -maxDD
      let floor = -maxDD;

      for (let i = 0; i < MAX_TRADES; i++) {
        // One trade per day
        const isWin = rng() < winRate;
        const pnl = isWin ? avgWin : -avgLoss;

        // For intraday mode, check intraday DD during the trade
        if (!isEOD) {
          // Intraday: floor tracks peak including unrealized
          // Simplified: check if balance + pnl would breach intraday floor
          const intradayLow = cur + Math.min(0, pnl);
          if (intradayLow < floor && isWin === false) {
            // intraday trailing follows you down
            if (intradayLow <= floor) {
              // actually for intraday, the floor moves WITH you in real time
              // so if you hit the floor at any point during the trade, you fail
              return { passed: false, trades: i + 1, finalBalance: intradayLow };
            }
          }
        }

        // Daily loss limit check (if applicable)
        if (dailyLoss > 0 && pnl < 0) {
          // Simplified: one trade per day, so daily P&L = this trade's P&L
          if (Math.abs(pnl) >= dailyLoss) {
            return { passed: false, trades: i + 1, finalBalance: cur + pnl };
          }
        }

        cur += pnl;

        // Update EOD trailing floor
        if (isEOD) {
          // Trailing DD: floor = max(balance - maxDD, -maxDD)
          // But locks at breakeven (0) if firm has that feature
          if (firm.trailing_dd_locks_at_breakeven && cur >= maxDD) {
            // Once you've earned the full cushion, floor locks at breakeven
            floor = Math.max(floor, 0);
          } else {
            const newFloor = cur - maxDD;
            floor = Math.max(floor, newFloor);
            if (firm.trailing_dd_locks_at_breakeven && floor >= 0) {
              floor = 0;
            }
          }
        } else {
          // Intraday: floor moves with balance in real-time
          if (firm.trailing_dd_locks_at_breakeven && cur >= maxDD) {
            floor = Math.max(floor, 0);
          } else {
            const newFloor = cur - maxDD;
            floor = Math.max(floor, newFloor);
            if (firm.trailing_dd_locks_at_breakeven && floor >= 0) {
              floor = 0;
            }
          }
        }

        // Check drawdown breach
        if (cur < floor) {
          return { passed: false, trades: i + 1, finalBalance: cur };
        }

        // Check profit target
        if (cur >= target) {
          return { passed: true, trades: i + 1, finalBalance: cur };
        }
      }

      // Ran out of trades without hitting target or DD
      return { passed: false, trades: MAX_TRADES, finalBalance: cur };
    }

    // Single funded-phase attempt
    function simulateFundedAttempt(winRate, avgWin, avgLoss, rng) {
      // $2k EOD trailing drawdown on funded account
      // Trade 1/day until +$2,000 or bust
      const fundedDD = 2000;
      let cur = 0;
      let floor = -fundedDD;

      for (let i = 0; i < MAX_TRADES; i++) {
        const isWin = rng() < winRate;
        const pnl = isWin ? avgWin : -avgLoss;
        cur += pnl;

        // Update floor (locks at breakeven after reaching +$2k cushion)
        if (cur >= fundedDD) {
          floor = Math.max(floor, 0);
        } else {
          const newFloor = cur - fundedDD;
          floor = Math.max(floor, newFloor);
          if (floor >= 0) floor = 0;
        }

        // Check bust
        if (cur < floor) {
          return { payout: 0 };
        }

        // Check reached +$2,000
        if (cur >= fundedDD) {
          // Withdraw $1,000, lock DD at breakeven
          // Then need 5 more winning days for another $1,000
          // Model: after reaching +$2k, probability of getting 5 more winning days
          let winningDays = 0;
          let postBalance = fundedDD - 1000; // withdrew $1k, balance resets
          let postFloor = 0; // locked at breakeven

          for (let j = 0; j < MAX_TRADES; j++) {
            const isWin2 = rng() < winRate;
            const pnl2 = isWin2 ? avgWin : -avgLoss;

            // Only count winning days (need 5)
            if (isWin2) winningDays++;

            postBalance += pnl2;

            // Trailing DD locked at breakeven, so floor stays at 0
            // But new floor follows balance minus DD, locked at 0 min
            const newFloor2 = postBalance - fundedDD;
            postFloor = Math.max(postFloor, 0); // stays locked
            if (postFloor < newFloor2) postFloor = newFloor2;
            if (postFloor < 0) postFloor = 0;

            if (postBalance < postFloor) {
              return { payout: 1000 }; // got first payout, busted on second cycle
            }

            if (winningDays >= 5) {
              return { payout: 2000 }; // got both payouts
            }
          }
          return { payout: 1000 }; // got first payout, didn't complete 5 winning days
        }
      }
      return { payout: 0 }; // never reached +$2k
    }

    // Full simulation: run all firms and return ranking
    function runSimulation(totalTrades, wins, avgWin, avgLoss) {
      const winRate = wins / Math.max(totalTrades, 1);
      const baseSeed = seedFrom(totalTrades, wins, avgWin, avgLoss);
      console.time('EV simulation');
      const results = FIRMS.map((firm, idx) => {
        // Each firm gets a deterministic seed derived from inputs + firm slug
        let firmSeed = baseSeed;
        for (let i = 0; i < firm.slug.length; i++) {
          firmSeed = ((firmSeed << 5) - firmSeed + firm.slug.charCodeAt(i)) | 0;
        }
        firmSeed = Math.abs(firmSeed) || 1;
        const rng = mulberry32(firmSeed);

        // Eval phase: 1000 attempts
        let passCount = 0;
        let samplePath = null;
        for (let p = 0; p < PASSES; p++) {
          const result = simulateEvalAttempt(winRate, avgWin, avgLoss, firm, rng);
          if (result.passed) {
            passCount++;
            if (!samplePath) samplePath = result;
          }
        }
        const passProb = passCount / PASSES;

        // Funded phase: 2000 attempts (only if passProb > 0)
        let fundedPayout = 0;
        if (passProb > 0) {
          let totalPayout = 0;
          for (let p = 0; p < FUNDED_PASSES; p++) {
            const fr = simulateFundedAttempt(winRate, avgWin, avgLoss, rng);
            totalPayout += fr.payout;
          }
          fundedPayout = totalPayout / FUNDED_PASSES;
        }

        const evalCost = firm.account.eval_cost;
        const activationFee = firm.activation_fee || 0;
        const ev = passProb * fundedPayout - passProb * activationFee - evalCost;
        const costToFunded = passProb > 0 ? evalCost / passProb + activationFee : Infinity;

        return {
          firm: firm,
          passProb: passProb,
          fundedPayout: fundedPayout,
          expectedPayout: passProb * fundedPayout,
          ev: ev,
          costToFunded: costToFunded,
          evalCost: evalCost,
          activationFee: activationFee,
          roiPct: evalCost > 0 ? (ev / evalCost) * 100 : 0
        };
      });

      // Sort by EV descending
      results.sort((a, b) => b.ev - a.ev);
      console.timeEnd('EV simulation');
      return results;
    }

    // Calculate derived stats
    function calcStats(totalTrades, wins, avgWin, avgLoss) {
      const losses = totalTrades - wins;
      const winRate = wins / Math.max(totalTrades, 1);
      const expectancy = winRate * avgWin - (1 - winRate) * avgLoss;
      const profitFactor = losses > 0 ? (wins * avgWin) / (losses * avgLoss) : Infinity;
      const rr = avgLoss > 0 ? avgWin / avgLoss : 0;
      const totalPnl = wins * avgWin - losses * avgLoss;
      // Max consecutive losses estimate (simple heuristic from win rate)
      const maxConsecutive = Math.ceil(Math.log(1 - 0.95) / Math.log(Math.max(1 - winRate, 0.01)));
      return {
        totalTrades, wins, losses, winRate, avgWin, avgLoss,
        expectancy, profitFactor, rr, totalPnl, maxConsecutive: Math.min(maxConsecutive, totalTrades)
      };
    }

